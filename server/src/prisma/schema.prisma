generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String            @id
  name                String
  email               String            @unique
  emailVerified       Boolean           @default(false)
  image               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  role                Role              @default(CLUB)
  department          String?
  facultyId           String?
  clubName            String?
  isActive            Boolean           @default(true)
  accounts            Account[]
  settingsUpdated     AppSetting[]
  auditLogs           AuditLog[]
  decisionsApproved   BookingDecision[] @relation("DecisionApprover")
  decisionsMade       BookingDecision[] @relation("DecisionMaker")
  bookingRequests     BookingRequest[]
  changesDeptApproved ChangeProposal[]  @relation("ChangeDeptApprover")
  changesRequested    ChangeProposal[]  @relation("ChangeRequester")
  changesReviewed     ChangeProposal[]  @relation("ChangeReviewer")
  datasetsUploaded    Dataset[]         @relation("DatasetUploader")
  examsGenerated      ExamSchedule[]
  jobs                Job[]
  llmCalls            LlmCall[]
  sessions            Session[]
  timetablesGenerated Timetable[]       @relation("TimetableGenerator")
  timetablesPublished Timetable[]       @relation("TimetablePublisher")

  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Dataset {
  id              String           @id @default(cuid())
  datasetKey      String
  label           String
  version         Int
  source          DatasetSource
  data            Json
  summary         Json
  isActive        Boolean          @default(false)
  parentId        String?
  uploadedById    String?
  createdAt       DateTime         @default(now())
  bookingRequests BookingRequest[]
  changesBasedOn  ChangeProposal[] @relation("ChangeBaseDataset")
  changesProduced ChangeProposal[] @relation("ChangeResultDataset")
  parent          Dataset?         @relation("DatasetLineage", fields: [parentId], references: [id])
  children        Dataset[]        @relation("DatasetLineage")
  uploadedBy      User?            @relation("DatasetUploader", fields: [uploadedById], references: [id])
  examSchedules   ExamSchedule[]
  timetables      Timetable[]

  @@unique([datasetKey, version])
  @@index([isActive])
  @@map("datasets")
}

model Timetable {
  id                 String            @id @default(cuid())
  datasetId          String
  status             PublishStatus     @default(DRAFT)
  label              String?
  schedule           Json
  report             Json
  hardViolationCount Int
  softTotal          Int
  softBreakdown      Json
  solverMeta         Json?
  parentId           String?
  generatedById      String?
  publishedById      String?
  publishedAt        DateTime?
  createdAt          DateTime          @default(now())
  bookingDecisions   BookingDecision[]
  changesBasedOn     ChangeProposal[]  @relation("ChangeBaseTimetable")
  changesProduced    ChangeProposal[]  @relation("ChangeResultTimetable")
  dataset            Dataset           @relation(fields: [datasetId], references: [id])
  generatedBy        User?             @relation("TimetableGenerator", fields: [generatedById], references: [id])
  parent             Timetable?        @relation("TimetableLineage", fields: [parentId], references: [id])
  children           Timetable[]       @relation("TimetableLineage")
  publishedBy        User?             @relation("TimetablePublisher", fields: [publishedById], references: [id])

  @@index([datasetId, status])
  @@map("timetables")
}

model ExamSchedule {
  id                 String        @id @default(cuid())
  datasetId          String
  status             PublishStatus @default(DRAFT)
  exams              Json
  report             Json
  hardViolationCount Int
  softPenalty        Int
  generatedById      String?
  publishedAt        DateTime?
  createdAt          DateTime      @default(now())
  dataset            Dataset       @relation(fields: [datasetId], references: [id])
  generatedBy        User?         @relation(fields: [generatedById], references: [id])

  @@index([datasetId, status])
  @@map("exam_schedules")
}

model BookingRequest {
  id                 String            @id @default(cuid())
  datasetId          String
  externalId         String
  requesterId        String?
  requesterName      String
  requesterRole      Role
  requestedCategory  BookingCategory
  effectiveCategory  BookingCategory
  title              String
  attendance         Int
  durationPeriods    Int
  windows            Json
  roomTypes          String[]
  needs              String[]
  requestedRoom      String?
  mandatoryForGroups String[]
  seriesId           String?
  rawText            String?
  llmDraft           Json?
  submittedAt        DateTime
  status             RequestStatus     @default(SUBMITTED)
  cancelledAt        DateTime?
  cancelNote         String?
  createdAt          DateTime          @default(now())
  decisions          BookingDecision[]
  dataset            Dataset           @relation(fields: [datasetId], references: [id])
  requester          User?             @relation(fields: [requesterId], references: [id])

  @@unique([datasetId, externalId])
  @@index([datasetId, status])
  @@index([requesterId])
  @@index([seriesId])
  @@map("booking_requests")
}

model BookingDecision {
  id            String            @id @default(cuid())
  requestId     String
  timetableId   String?
  status        DecisionStatus
  day           String?
  startPeriod   Int?
  endPeriod     Int?
  roomId        String?
  reason        String
  source        DecisionSource
  decidedById   String?
  approvalState ApprovalState     @default(NOT_REQUIRED)
  approvedById  String?
  approvedAt    DateTime?
  isCurrent     Boolean           @default(true)
  createdAt     DateTime          @default(now())
  approvedBy    User?             @relation("DecisionApprover", fields: [approvedById], references: [id])
  decidedBy     User?             @relation("DecisionMaker", fields: [decidedById], references: [id])
  request       BookingRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  timetable     Timetable?        @relation(fields: [timetableId], references: [id])
  overrides     SessionOverride[]

  @@index([requestId, isCurrent])
  @@index([approvalState])
  @@map("booking_decisions")
}

model SessionOverride {
  id         String          @id @default(cuid())
  decisionId String
  sessionId  String
  fromDay    String
  fromStart  Int
  fromRoom   String
  toDay      String
  toStart    Int
  toRoom     String
  decision   BookingDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@map("session_overrides")
}

model ChangeProposal {
  id                String       @id @default(cuid())
  source            ChangeSource
  status            ChangeStatus @default(SUBMITTED)
  baseDatasetId     String
  baseTimetableId   String
  requestedById     String
  originalText      String?
  disruption        Json
  proposedSchedule  Json?
  appliedDataset    Json?
  diff              Json?
  movedCount        Int?
  timeChangedCount  Int?
  roomOnlyCount     Int?
  report            Json?
  conflicts         Json?
  explanation       String?
  deptApprovedById  String?
  deptApprovedAt    DateTime?
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNote        String?
  resultDatasetId   String?
  resultTimetableId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  baseDataset       Dataset      @relation("ChangeBaseDataset", fields: [baseDatasetId], references: [id])
  baseTimetable     Timetable    @relation("ChangeBaseTimetable", fields: [baseTimetableId], references: [id])
  deptApprovedBy    User?        @relation("ChangeDeptApprover", fields: [deptApprovedById], references: [id])
  requestedBy       User         @relation("ChangeRequester", fields: [requestedById], references: [id])
  resultDataset     Dataset?     @relation("ChangeResultDataset", fields: [resultDatasetId], references: [id])
  resultTimetable   Timetable?   @relation("ChangeResultTimetable", fields: [resultTimetableId], references: [id])
  reviewedBy        User?        @relation("ChangeReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([requestedById])
  @@map("change_proposals")
}

model Job {
  id          String    @id @default(cuid())
  kind        JobKind
  state       JobState  @default(QUEUED)
  progress    Int       @default(0)
  message     String?
  params      Json?
  resultType  String?
  resultId    String?
  error       String?
  createdById String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  createdBy   User?     @relation(fields: [createdById], references: [id])

  @@index([state])
  @@map("jobs")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  Role?
  action     String
  entityType String
  entityId   String?
  summary    String
  details    Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model LlmCall {
  id             String     @id @default(cuid())
  userId         String?
  purpose        LlmPurpose
  model          String
  promptVersion  String
  input          String
  output         Json?
  validationOk   Boolean?
  rejectedReason String?
  latencyMs      Int?
  error          String?
  createdAt      DateTime   @default(now())
  user           User?      @relation(fields: [userId], references: [id])

  @@index([purpose, createdAt])
  @@map("llm_calls")
}

model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation(fields: [updatedById], references: [id])

  @@map("app_settings")
}

enum Role {
  ADMIN
  COORDINATOR
  FACULTY
  CLUB
}

enum DatasetSource {
  SEED
  UPLOAD
  CHANGE_APPLIED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookingCategory {
  INSTITUTE_EVENT
  GUEST_LECTURE
  DEPARTMENT_EVENT
  CLUB_EVENT
}

enum RequestStatus {
  SUBMITTED
  APPROVED
  ALTERNATIVE_OFFERED
  REJECTED
  CANCELLED
}

enum DecisionStatus {
  APPROVED
  ALTERNATIVE_OFFERED
  REJECTED
}

enum DecisionSource {
  RULE_ENGINE
  ADMIN_OVERRIDE
  MANUAL
}

enum ApprovalState {
  NOT_REQUIRED
  PENDING_ADMIN
  DEPT_APPROVED
  APPROVED
  REJECTED
}

enum ChangeSource {
  ADMIN_FORM
  ADMIN_FILE
  FACULTY_ASSISTANT
  FACULTY_UNAVAILABILITY
  COORDINATOR_REQUEST
  MANUAL_MOVE
}

enum ChangeStatus {
  SUBMITTED
  PROPOSED
  DEPT_APPROVED
  APPROVED
  REJECTED
  IMPOSSIBLE
  WITHDRAWN
}

enum JobKind {
  GENERATE_TIMETABLE
  GENERATE_EXAMS
  DECIDE_BOOKINGS
  REPAIR
}

enum JobState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum LlmPurpose {
  BOOKING_PARSE
  FACULTY_ASSISTANT
  EXPLAIN
}

{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API server",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "generate": "prisma generate",
    "seed:demo-users": "tsx scripts/seed-demo-users.ts",
    "test": "vitest run src && tsc --noEmit -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.14",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "multer": "^2.5.0",
    "openai": "^7.47.0",
    "pg": "^8.23.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prettier": "3.8.1",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}

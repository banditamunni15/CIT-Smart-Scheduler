PORT=5000
DATABASE_URL="postgresql://admin:admin@localhost:5432/postgres?schema=public"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# uncomment next line if you use Prisma <5.10
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
BETTER_AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000
ENGINE_MODE=real
ENGINE_URL=http://localhost:8000
ENGINE_TIMEOUT_MS=60000
DEMO_USER_PASSWORD="DemoPassword123!"
# Set this to enable the signed-in scheduler assistant.
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
